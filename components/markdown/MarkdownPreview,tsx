// components/markdown/MarkdownPreview.tsx
import React from 'react';
import { Box, Paper, Typography } from '@mui/material';
import MarkdownRenderer from './MarkdownRenderer';

interface MarkdownPreviewProps {
  content: string;
  title?: string;
  darkMode?: boolean;
  minHeight?: string | number;
  maxHeight?: string | number;
}

const MarkdownPreview: React.FC<MarkdownPreviewProps> = ({
  content,
  title,
  darkMode = true,
  minHeight = 'auto',
  maxHeight = '100%'
}) => {
  // Define theme colors based on dark/light mode
  const bgColor = darkMode ? '#21222c' : '#f8f8f2';
  const borderColor = darkMode ? '#44475a' : '#cbd5e1';
  const textColor = darkMode ? '#f8f8f2' : '#282a36';
  const headingColor = darkMode ? '#bd93f9' : '#6d28d9';

  return (
    <Paper
      elevation={0}
      sx={{
        p: 3,
        backgroundColor: bgColor,
        overflow: 'auto',
        border: `1px solid ${borderColor}`,
        borderRadius: 1,
        minHeight,
        maxHeight,
      }}
    >
      {title && (
        <Typography 
          variant="subtitle1" 
          sx={{ 
            mb: 2,
            color: headingColor,
            fontWeight: 'bold',
            borderBottom: `1px solid ${borderColor}`,
            pb: 1
          }}
        >
          {title}
        </Typography>
      )}
      
      <Box
        className="markdown-content"
        sx={{
          color: textColor,
          '& h1': { 
            color: darkMode ? '#ff79c6' : '#be185d',
            fontSize: '2.25rem', 
            fontWeight: 'bold', 
            borderBottom: `1px solid ${borderColor}`,
            pb: 1,
            mb: 2
          },
          '& h2': { 
            color: darkMode ? '#bd93f9' : '#7c3aed',
            fontSize: '1.75rem', 
            fontWeight: 'bold', 
            mb: 2 
          },
          '& h3': { 
            color: darkMode ? '#8be9fd' : '#0ea5e9',
            fontSize: '1.5rem', 
            fontWeight: 'bold', 
            mb: 1.5 
          },
          '& p': { 
            fontSize: '1rem', 
            mb: 2,
            lineHeight: 1.6
          },
          '& .katex': {
            color: textColor,
            fontSize: '1.1em',
          },
          '& .math-display': {
            padding: '1rem 0',
            display: 'flex',
            justifyContent: 'center',
          },
          '& a': {
            color: darkMode ? '#8be9fd' : '#0284c7',
            textDecoration: 'underline',
          },
          '& strong': {
            color: darkMode ? '#ff79c6' : '#be185d',
            fontWeight: 'bold',
          },
          '& code': {
            backgroundColor: darkMode ? '#44475a' : '#f1f5f9',
            padding: '0.2em 0.4em',
            borderRadius: '3px',
            fontFamily: 'monospace',
          },
          '& pre': {
            backgroundColor: darkMode ? '#44475a' : '#f1f5f9',
            padding: '1em',
            borderRadius: '5px',
            overflow: 'auto',
            '& code': {
              backgroundColor: 'transparent',
              padding: 0,
            }
          },
          '& blockquote': {
            borderLeft: `4px solid ${darkMode ? '#6272a4' : '#cbd5e1'}`,
            paddingLeft: '1em',
            margin: '1em 0',
            color: darkMode ? '#f1fa8c' : '#64748b',
          },
          '& ul, & ol': {
            paddingLeft: '2em',
            marginBottom: '1em',
          },
          '& li': {
            margin: '0.5em 0',
          },
          '& table': {
            borderCollapse: 'collapse',
            width: '100%',
            marginBottom: '1em',
          },
          '& th, & td': {
            border: `1px solid ${darkMode ? '#6272a4' : '#cbd5e1'}`,
            padding: '0.5em',
            textAlign: 'left',
          },
          '& th': {
            backgroundColor: darkMode ? '#44475a' : '#f1f5f9',
            fontWeight: 'bold',
          }
        }}
      >
        <MarkdownRenderer content={content} />
      </Box>
    </Paper>
  );
};

export default MarkdownPreview;